{
  "name": "10cordes-bot",
  "version": "0.1.0",
  "private": true,
  "description": "A Spraxium Discord bot",
  "type": "module",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "scripts": {
    "dev": "pnpm --filter @10cordes/shared build && spraxium dev",
    "build": "pnpm --filter @10cordes/shared build && spraxium build && node ../../scripts/copy-config.mjs",
    "start": "spraxium start",
    "typecheck": "pnpm --filter @10cordes/shared build && tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@10cordes/shared": "workspace:*",
    "@discordjs/voice": "^0.19.2",
    "@napi-rs/canvas": "^1.2.0",
    "@prisma/client": "^7.10.1",
    "@spraxium/common": "^0.9.0",
    "@spraxium/components": "^0.9.0",
    "@spraxium/core": "^0.9.0",
    "@spraxium/env": "^0.9.0",
    "@spraxium/http": "^0.9.0",
    "@spraxium/i18n": "^0.9.0",
    "@spraxium/logger": "^0.9.0",
    "better-auth": "^1.7.27",
    "bullmq": "^6.7.8",
    "croner": "^11.0.1",
    "discord-html-transcripts": "^3.3.0",
    "discord.js": "^14.28.1",
    "fast-xml-parser": "^5.12.1",
    "ffmpeg-static": "^5.3.0",
    "gamedig": "^5.3.3",
    "hono": "^4.13.20",
    "ioredis": "^6.0.0",
    "libsodium-wrappers": "^0.8.4",
    "opusscript": "^0.1.1",
    "pdfkit": "^0.21.0",
    "ts-duckduckgo-search": "^0.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@spraxium/cli": "^0.9.0",
    "@types/libsodium-wrappers": "^0.8.2",
    "@types/node": "^26.6.6",
    "@types/pdfkit": "^0.17.7",
    "prisma": "^6.19.3",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
