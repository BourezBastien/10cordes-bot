# ── REQUIS au boot ──
DISCORD_TOKEN=your-bot-token-here

# ── Infrastructure (défauts sains, optionnels) ──
#DATABASE_URL=file:../data/bot.db
#REDIS_URL=                # vide = queue/cache en mémoire (dev) ; redis://redis:6379 en prod
#PORT=3000
#HTTP_HOST=127.0.0.1       # 0.0.0.0 en Docker
#DASHBOARD_ORIGIN=http://localhost:5173   # origines admises du panel, séparées par des virgules ; la première porte le rappel du login Discord
#DASHBOARD_DIST_DIR=../dashboard/dist     # panel compilé servi par le bot (pnpm --filter 10cordes-dashboard build) ; réglez alors DASHBOARD_ORIGIN sur l'origine d'où il est ouvert
#HTTP_API_KEY=             # clé de la sonde /healthz seule (header x-api-key) ; l'API du dashboard s'authentifie par la session

# ── Dashboard (optionnel : sans ces clés, la session répond 503 et le login web est fermé) ──
#BETTER_AUTH_SECRET=       # min 32 chars ; derive aussi la clé maîtresse du chiffrement
#DISCORD_CLIENT_ID=        # OAuth client ID (portail développeur Discord)
#DISCORD_CLIENT_SECRET=

# ── Chiffrement des secrets en DB (optionnel : sinon dérivé de BETTER_AUTH_SECRET) ──
#ENCRYPTION_SECRET=

# ── Clés des fournisseurs : lues UNE fois au démarrage pour remplir une base vide, puis ignorées ──
# Les clés vivent en base, chiffrées (AES-256-GCM). Une fois les lignes importées (audit
# instance.imported), ces variables peuvent être commentées : la base a la priorité absolue.
# Garder ENCRYPTION_SECRET ou BETTER_AUTH_SECRET : c'est la clé maîtresse qui déchiffre la base.
#LLM_API_URL=https://api.deepseek.com    # ou https://api.openai.com/v1, https://openrouter.ai/api/v1...
#LLM_API_KEY=sk-...
#LLM_MODEL=deepseek-flash                # ou gpt-4o-mini, llama-3.1-70b...
#KIE_API_KEY=                            # kie.ai : image, musique (modèles par capacité)
#KIE_MODEL=V6_MINI                       # modèle Suno de l'instance
#PIXELLAB_API_KEY=                       # PixelLab : pixel art (icônes, émojis, sprites)
#LLM_EFFORT=low                          # low/medium/high ; vide = non envoyé

# ── Dev rigs E2E (true UNIQUEMENT sur le serveur de dév, jamais en prod) ──
#E2E_ENABLED=false
#E2E_GUILD_ID=            # serveur de test des rigs e2e-*.mjs
