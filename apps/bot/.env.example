# ── REQUIS au boot ──
DISCORD_TOKEN=your-bot-token-here

# ── Infrastructure (défauts sains, optionnels) ──
#DATABASE_URL=file:../data/bot.db
#REDIS_URL=                # vide = queue/cache en mémoire (dev) ; redis://redis:6379 en prod
#PORT=3000
#HTTP_HOST=127.0.0.1       # 0.0.0.0 en Docker
#DASHBOARD_ORIGIN=http://localhost:5173
#HTTP_API_KEY=             # header x-api-key de l'API HTTP

# ── Dashboard (optionnel : sans ces clés, pas de login web) ──
#BETTER_AUTH_SECRET=       # min 32 chars
#DISCORD_CLIENT_SECRET=

# ── Chiffrement des secrets en DB (optionnel : sinon dérivé de BETTER_AUTH_SECRET) ──
#ENCRYPTION_SECRET=

# ── Bootstrap LLM (optionnel : tout aussi configurable depuis Discord, modal par bouton) ──
#LLM_API_URL=https://api.deepseek.com    # ou https://api.openai.com/v1, https://openrouter.ai/api/v1...
#LLM_API_KEY=sk-...
#LLM_MODEL=deepseek-flash                # ou gpt-4o-mini, llama-3.1-70b...
#LLM_EFFORT=low                          # low/medium/high ; vide = non envoyé

# ── Dev rigs E2E (true sur le serveur de dév uniquement) ──
#E2E_ENABLED=false
