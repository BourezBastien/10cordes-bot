# Discord bot token — https://discord.com/developers/applications (Bot page, Reset Token)
DISCORD_TOKEN=
# Application ID — https://discord.com/developers/applications (General Information)
DISCORD_CLIENT_ID=
# OAuth2 Client Secret — same page, reset then copy
DISCORD_CLIENT_SECRET=
# SQLite relative to apps/bot/prisma (switch to postgresql later if needed)
DATABASE_URL=file:../data/bot.db
# better-auth encryption secret (min 32 chars) — generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Dashboard public origin (CORS + OAuth redirects)
DASHBOARD_ORIGIN=https://bot.10codes.io
# HTTP API port
PORT=3000
# Optional server-to-server API key (x-api-key header)
HTTP_API_KEY=
# PixelLab API key — https://pixellab.ai (pixel art generation, images + emojis)
PIXELLAB_API_KEY=
# DeepSeek API key — https://platform.deepseek.com/api_keys (LLM agent, OpenAI-compatible)
DEEPSEEK_API_KEY=
# Model name served by the provider (deepseek-flash, deepseek-v4-pro, ...)
DEEPSEEK_MODEL=deepseek-flash
# E2E test rig: comma-separated webhook IDs whose messages speak with staff
# permissions (entry key = the webhook token itself). Empty = disabled.
E2E_STAFF_WEBHOOK_IDS=
# kie.ai API key — https://docs.kie.ai (Suno music generation, generateMusic tool)
KIE_API_KEY=
# Reasoning effort of the thinking model (low = fast replies)
DEEPSEEK_EFFORT=low
# Suno model served by kie.ai (V6_MINI = best value, V6 = max quality)
KIE_MODEL=V6_MINI
# Durable task queue - without it the queue falls back to in-memory
REDIS_URL=redis://127.0.0.1:6379
# Bot name recognized in plain text (no mention needed)
DISCORD_BOT_NAME=10cordes
# Extra nicknames recognized in plain text (comma-separated)
DISCORD_BOT_ALIASES=
# Master switch for the E2E test rigs (true on the dev server only)
E2E_ENABLED=false
# Other bots to IGNORE: comma-separated names/nicknames/initials. Messages
# addressed to them ("jp fais ça") never trigger 10cordes.
DISCORD_OTHER_BOTS=
