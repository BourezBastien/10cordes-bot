// 10cordes-bot — schéma P0.
// Les tables better-auth (User, Session, Account, Verification) seront ajoutées
// à l'étape API (P0-6) via `npx @better-auth/cli generate --output prisma/schema.prisma`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Guild {
  id                String             @id
  settings          String             @default("{}")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  guildModuleStates GuildModuleState[]

  @@map("guilds")
}

model GuildModuleState {
  id          String  @id @default(cuid())
  guildId     String
  moduleId    String
  enabled     Boolean @default(true)
  constraints String  @default("{}")
  guild       Guild   @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, moduleId])
  @@map("guild_module_states")
}

model UserLocale {
  userId    String   @id
  locale    String
  source    String   @default("auto")
  updatedAt DateTime @updatedAt

  @@map("user_locales")
}

// ── better-auth (générées conformément au schéma officiel — CLI `@better-auth/cli generate`) ──

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// ── Audit (0.11) ─────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  guildId   String?
  source    String   @default("system")
  action    String
  actorId   String?
  targetId  String?
  metadata  String   @default("{}")
  createdAt DateTime @default(now())

  @@index([guildId, createdAt])
  @@map("audit_logs")
}

// ── Modération (1.3) ─────────────────────────────────────────

model ModCounter {
  guildId String @id
  value   Int    @default(0)

  @@map("mod_counters")
}

model ModCase {
  id          String   @id @default(cuid())
  guildId     String
  caseId      Int
  userId      String
  moderatorId String
  action      String
  reason      String?
  durationMs  Int?
  createdAt   DateTime @default(now())

  @@unique([guildId, caseId])
  @@index([guildId, userId])
  @@map("mod_cases")
}

model RoleBackup {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  roleIds   String
  createdBy String
  createdAt DateTime @default(now())

  @@index([guildId, userId])
  @@map("role_backups")
}

// ── Tags (1.4) ───────────────────────────────────────────────

model Tag {
  id        String   @id @default(cuid())
  guildId   String
  name      String
  content   String
  createdBy String
  uses      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, name])
  @@map("tags")
}
