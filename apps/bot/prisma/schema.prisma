// 10cordes-bot — schéma P0.
// Les tables better-auth (User, Session, Account, Verification) ont été ajoutées
// à l'étape API (P0-6) via `npx @better-auth/cli generate --output prisma/schema.prisma`.
// Décision 18/11 : toutes les tables guild-scopées portent une VRAIE relation
// vers Guild avec onDelete: Cascade — la suppression d'un serveur nettoie tout.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Guild {
  id                String             @id
  settings          String             @default("{}")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  guildModuleStates GuildModuleState[]
  auditLogs         AuditLog[]
  modCases          ModCase[]
  modCounter        ModCounter?
  roleBackups       RoleBackup[]
  tags              Tag[]
  adminWhitelist    AdminWhitelist[]
  agentSkills       AgentSkill[]
  agentAutomations  AgentAutomation[]
  agentPanels       AgentPanel[]
  agentPlans        AgentPlan[]
  ticketCounter     TicketCounter?
  tickets           Ticket[]
  userLevels        UserLevel[]
  guildMemories     GuildMemory[]
  guildMemoryProfile GuildMemoryProfile?
  memberMemories    MemberMemory[]
  memberMemoryProfiles MemberMemoryProfile[]

  @@map("guilds")
}

model GuildModuleState {
  id          String  @id @default(cuid())
  guildId     String
  moduleId    String
  enabled     Boolean @default(true)
  constraints String  @default("{}")
  guild       Guild   @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, moduleId])
  @@map("guild_module_states")
}

model UserLocale {
  userId    String   @id
  locale    String
  source    String   @default("auto")
  updatedAt DateTime @updatedAt

  @@map("user_locales")
}

// ── better-auth (générées conformément au schéma officiel — CLI `@better-auth/cli generate`) ──

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// ── Audit (0.11) ─────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  guildId   String?
  source    String   @default("system")
  action    String
  actorId   String?
  targetId  String?
  metadata  String   @default("{}")
  createdAt DateTime @default(now())
  guild     Guild?   @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, createdAt])
  @@index([action])
  @@map("audit_logs")
}

// ── Modération (1.3) ─────────────────────────────────────────

model ModCounter {
  value   Int    @default(0)
  guildId String @id
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@map("mod_counters")
}

model ModCase {
  id          String   @id @default(cuid())
  guildId     String
  caseId      Int
  userId      String
  moderatorId String
  action      String
  reason      String?
  durationMs  Int?
  createdAt   DateTime @default(now())
  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, caseId])
  @@index([guildId, userId])
  @@map("mod_cases")
}

model RoleBackup {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  roleIds   String
  createdBy String
  createdAt DateTime @default(now())
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, userId])
  @@map("role_backups")
}

// ── Tags (1.4) ───────────────────────────────────────────────

model Tag {
  id        String   @id @default(cuid())
  guildId   String
  name      String
  content   String
  createdBy String
  uses      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, name])
  @@map("tags")
}

// ── Agent Admin (P2) ─────────────────────────────────────────

model AdminWhitelist {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  addedBy   String
  createdAt DateTime @default(now())
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, userId])
  @@map("admin_whitelist")
}

// ── Skills : règles de comportement durables (trigger + règle), par serveur ──

model AgentSkill {
  id              String    @id @default(cuid())
  guildId         String
  trigger         String
  rule            String
  createdByUserId String
  usageCount      Int       @default(0)
  createdAt       DateTime  @default(now())
  deletedAt       DateTime?
  guild           Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, deletedAt])
  @@map("agent_skills")
}

// ── Automatisations créées par l'agent (event → actions) ──

model AgentAutomation {
  id              String   @id @default(cuid())
  guildId         String
  name            String
  triggerType     String // message.created | member.joined | member.left | channel.created
  triggerFilter   String   @default("{}") // JSON: { channelId?, contains?, userIds? }
  actions         String   @default("[]") // JSON: [{ type, params }]
  enabled         Boolean  @default(true)
  createdByUserId String
  createdAt       DateTime @default(now())
  guild           Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, enabled])
  @@map("agent_automations")
}

// ── Watermark de reprise au boot (récupération des demandes manquées) ──

model ChannelWatermark {
  channelId     String   @id
  lastMessageId String
  updatedAt     DateTime @updatedAt
  @@map("channel_watermarks")
}

// ── Panels interactifs construits par l'agent (boutons + sélecteur) ──

model AgentPanel {
  id              String   @id @default(cuid())
  guildId         String
  channelId       String
  messageId       String
  kind            String   @default("custom") // ticket | poll | custom
  definition      String // JSON: { title, description, selectMenu?, buttons? }
  createdByUserId String
  createdAt       DateTime @default(now())
  guild           Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, messageId])
  @@map("agent_panels")
}

model AgentPlan {
  id             String   @id @default(cuid())
  guildId        String
  channelId      String
  requesterId    String
  title          String
  ops            String
  status         String   @default("pending")
  results        String?
  approvedBy     String?
  panelMessageId String?
  createdAt      DateTime @default(now())
  expiresAt      DateTime
  guild          Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, status])
  @@map("agent_plans")
}

// ── Tickets (P2) ─────────────────────────────────────────────

model TicketCounter {
  value   Int    @default(0)
  guildId String @id
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@map("ticket_counters")
}

model Ticket {
  id              String    @id @default(cuid())
  guildId         String
  number          Int
  channelId       String
  userId          String
  status          String    @default("open")
  priority        String    @default("LOW")
  claimedBy       String?
  firstResponseAt DateTime?
  createdAt       DateTime  @default(now())
  closedAt        DateTime?
  guild           Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  feedbacks       TicketFeedback[]

  @@unique([guildId, channelId])
  @@index([guildId, userId])
  @@map("tickets")
}

// Feedback post-fermeture (notation 1-5 par l'ouverture du ticket, avant suppression du salon)
model TicketFeedback {
  id        String   @id @default(cuid())
  guildId   String
  ticketId  String
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([ticketId, userId])
  @@map("ticket_feedbacks")
}

// ── Leveling (P2) ────────────────────────────────────────────

model UserLevel {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  xp        Int      @default(0)
  level     Int      @default(0)
  updatedAt DateTime @updatedAt
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, userId])
  @@index([guildId, xp])
  @@map("user_levels")
}

// ── Intégrations configurables au runtime (modale owner, sans restart) ──

model IntegrationConfig {
  id        String   @id // 'llm' | 'imagelab'
  provider  String   @default("custom")
  baseUrl   String
  apiKey    String
  model     String   @default("")
  updatedAt DateTime @updatedAt
}

// ── Mémoire persistante de l'agent IA (append-only) ─────────

model GuildMemory {
  id        String   @id @default(cuid())
  guildId   String
  kind      String   @default("fact") // fact | rule | presentation | preference
  content   String
  createdAt DateTime @default(now())
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
  @@map("guild_memories")
}

model MemberMemory {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  kind      String   @default("fact") // fact | preference | note
  content   String
  createdAt DateTime @default(now())
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, userId])
  @@map("member_memories")
}

// ── Fiches mémoire consolidées (curator LLM, inspiration Discord-AI-Bot) ──

model MemberMemoryProfile {
  guildId   String
  userId    String
  text      String   @default("")
  updatedAt DateTime @updatedAt
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@id([guildId, userId])
  @@map("member_memory_profiles")
}

model GuildMemoryProfile {
  guildId   String          @id
  text      String          @default("")
  updatedAt DateTime        @updatedAt
  guild     Guild           @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@map("guild_memory_profiles")
}
