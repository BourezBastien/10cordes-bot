{
  "name": "10cordes",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter 10cordes-bot dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:modules": "node scripts/check-modules.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:modules"
  },
  "devDependencies": {
    "@bluzzi/eslint-config": "^2.4.2",
    "eslint": "^10.15.0"
  }
}
